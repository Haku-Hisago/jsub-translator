# ═══════════════════════════════════════════════════════
# jsub-translator 配置文件
# 复制此文件为 .env 并填入你的设置
#
# 提示：API Key 也可以直接在网页界面的「API Key」输入框填写，
#       此时本文件的 API Key 可留空（界面填写的优先级更高）。
# ═══════════════════════════════════════════════════════

# --- 翻译引擎 ---
# 可选: index（默认，本地 Index-Translate-2B，免费、术语可控）
#       deepseek（云端，便宜快速）
#       anthropic（云端，质量优先）
TRANSLATION_PROVIDER=index

# ───────────────────────────────────────────────────────
# Index-Translate-2B（本地 vLLM 服务）—— 默认引擎
# ───────────────────────────────────────────────────────
# 官方仓库: https://github.com/bilibili/Index-Translate
# 部署步骤: 见 docs/index-translate.md（Windows + WSL2 + vLLM）
#
# 起服务（WSL2 里执行）：
#   vllm serve IndexTeam/Index-Translate-2B \
#       --host 127.0.0.1 --port 8000 --max-model-len 32768
#
# 服务是 OpenAI 兼容接口，所以不需要任何额外 Python 依赖。
INDEX_BASE_URL=http://127.0.0.1:8000/v1
# 本地 vLLM 不校验 key，官方约定填 EMPTY。这不是密钥，不要填真 key。
INDEX_API_KEY=EMPTY
# 模型 ID，必须与服务端 /v1/models 返回的一致。
# 部署量化版（如 -FP8）时改成对应 ID。
# 不确定的话：启动服务后浏览器打开 INDEX_BASE_URL + /models 看实际值。
INDEX_MODEL=IndexTeam/Index-Translate-2B

# 生成上限（官方 Translate 系列默认 1024）与解码温度（官方默认 0 = 贪心）
INDEX_MAX_TOKENS=1024
INDEX_TEMPERATURE=0.0
# 单次请求超时（秒）。本地首次加载模型 / 长批可能较慢，给宽一点。
INDEX_TIMEOUT=300
# 是否要求跳过思维链（官方默认 false）。若服务端不支持这个参数会自动降级。
INDEX_ENABLE_THINKING=false

# 每批字幕条数（10~30 是准确性与吞吐的平衡区）
INDEX_BATCH_SIZE=20
# 批与批之间携带的上下文条数（仅供模型理解语境，不翻译它们）
# before = 已翻好的前文；after = 尚未翻译的后文
INDEX_CONTEXT_BEFORE=3
INDEX_CONTEXT_AFTER=3

# 术语表（dynamic glossary）：只把本批真正命中的词条发给模型
INDEX_GLOSSARY_ENABLED=true
# 词典目录（相对「程序所在目录」解析）。目录下所有 *.yaml 都会被加载。
INDEX_GLOSSARY_DIRS=dictionary

# 译文校验：条数/id 对应/空译文/Markdown/解释文字/术语落实
INDEX_VALIDATION_ENABLED=true
# 校验不通过时的重试次数（0 = 只校验不重试）；仍不过会缩批重试
INDEX_VALIDATION_RETRY=2
# 译文长度上限（相对日文原文的字符数倍率）。超过则**请模型压缩**，不截断。
INDEX_MAX_LENGTH_RATIO=1.8

# ───────────────────────────────────────────────────────
# 备用引擎（fallback）—— 默认关闭
# ───────────────────────────────────────────────────────
# 打开后，Index 翻不出来的批次会改用下面的引擎重试。
# 注意：这会调用云端 API，**产生费用**，所以默认关闭。
FALLBACK_ENABLED=false
FALLBACK_PROVIDER=deepseek

# --- DeepSeek API（可选引擎 / 可作 fallback）---
# 注册获取 Key: https://platform.deepseek.com/api_keys
# DeepSeek 价格极低，日→中翻译质量好
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Anthropic API（可选引擎）---
# 获取 Key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# --- Whisper 模型（多模型并行识别 + 大模型融合）---
# 主转录模型：负责字幕时间轴/分段骨架，选质量最高者
WHISPER_MODEL=large-v3-turbo
# 参考转录模型（逗号分隔）：与主模型并行识别，供大模型交叉比对验证
WHISPER_REFERENCE_MODELS=medium
# 推理设备：cuda=NVIDIA GPU（需 ctranslate2 含 CUDA + 已装驱动）；cpu=纯 CPU
WHISPER_DEVICE=cuda
# 计算精度：GPU 用 float16；CPU 用 int8
WHISPER_COMPUTE_TYPE=float16

# --- 多路转写融合 ---
# 融合（比对验证）使用的 LLM 引擎；留空=与翻译引擎相同
FUSE_PROVIDER=
# 融合阶段每次调用的字幕条数
FUSE_BATCH_SIZE=15

# --- 上下文与连贯性 ---
# 跨批次携带的「上文语境」条数（0 = 关闭，解决指代/话题/术语跨批次不一致）
CONTEXT_WINDOW=4
# 翻译完成后是否运行一次 LLM 连贯性校对（去翻译腔、统一指代与术语）
ENABLE_REVIEW=true
# 校对引擎：留空=与翻译引擎相同；可填 deepseek / anthropic
REVIEW_PROVIDER=
# 校对阶段每次调用的字幕条数
REVIEW_BATCH_SIZE=15

# --- 说话人识别（区分角色，并让翻译按角色统一人称/语气）---
# 原理：Whisper 本身没有声纹能力，只能给出「说了什么 + 什么时候说」。
#       「谁在说」由独立的声纹模型解决，再按时间轴与字幕对齐。
#
# 后端选择：sherpa（默认，纯 CPU，无需 Token）| pyannote（需额外安装 + HF Token）
#          auto（依次尝试）| none（关闭）
DIARIZE_BACKEND=sherpa

# 说话人分割模型（sherpa-onnx 格式的 pyannote segmentation-3.0）
# 留空则使用 models/sherpa-onnx-pyannote-segmentation-3-0/model.onnx
DIARIZE_SEG_MODEL=
# 声纹嵌入模型（3D-Speaker ERes2Net，中日文场景通用）
# 留空则使用 models/3dspeaker_speech_eres2net_base_sv_zh-cn_3dspeaker_16k.onnx
DIARIZE_EMB_MODEL=

# 已知说话人数量时直接指定（更准）；-1 = 自动聚类
DIARIZE_NUM_SPEAKERS=-1

# 自动聚类阈值（仅当上面为 -1 时生效）
# 调小 → 说话人更多；调大 → 说话人更少。默认 0.92
# 实测（官方 4 人音频）：0.5→7 人，0.7→5 人，0.80~0.86→5 人，
#                       0.88~0.96→4 人 ✓，1.0→3 人
# 0.92 是平台区正中，比边缘值更稳。角色被拆太碎→0.96；角色被合并→0.88。
DIARIZE_CLUSTER_THRESHOLD=0.92

# 一条字幕横跨两个说话人时，是否用词级时间戳切成两条（默认开）
# 词级时间戳对不齐时会自动跳过，不会污染字幕
DIARIZE_SPLIT_ON_CHANGE=true

# Whisper 词级时间戳（说话人切分需要，默认开；设为 0 可省一点耗时）
WHISPER_WORD_TIMESTAMPS=1

# HuggingFace Token —— 仅 DIARIZE_BACKEND=pyannote 时需要，sherpa 不需要
HF_TOKEN=

# --- 下载（yt-dlp）---
# 为什么需要 cookies：YouTube 从 2024 年起对未登录的下载做机器人校验，
# 匿名请求会失败（报 "Sign in to confirm you're not a bot" 或
# "No video formats found!"）。Bilibili / Niconico 等通常不受影响。
# 带上浏览器 cookies（哪怕只是"登录过 YouTube"的会话）即可通过校验。
#
# 二选一，都留空 = 维持原行为（不发送 cookies）：
#   方式 1（推荐）：导出 cookies.txt 文件（浏览器扩展 "Get cookies.txt LOCALLY"）
#   方式 2：直接读浏览器 cookie 库（Chrome/Edge 新版常因加密/占用而失败）
#
# YTDLP_COOKIES_FILE 优先于 YTDLP_COOKIES_FROM_BROWSER。
# 相对路径相对「程序所在目录」（打包版 = EXE 所在目录）。
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=
# 下载失败自动重试次数
YTDLP_RETRIES=3

# --- 路径配置 ---
# 输出目录（生成的 ASS 字幕文件）
# 留空 = 自动用「程序所在目录/output」：
#   打包版 -> EXE 旁边的 output/    源码版 -> 项目根目录/output/
# 相对路径按「程序所在目录」解析（不是进程工作目录），也可直接填绝对路径。
OUTPUT_DIR=
# 模型缓存目录（Whisper 模型文件下载位置）
# 留空 = 自动用「程序所在目录/models」。同样支持相对/绝对路径。
MODEL_DIR=
